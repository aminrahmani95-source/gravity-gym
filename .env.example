# =============================================================================
# Iranian Fitness Membership Platform - Environment Configuration Specification
# =============================================================================
# In production, all required secrets MUST be explicitly supplied by the environment.
# When NODE_ENV=production, missing JWT_SECRET or QR_SIGNING_SECRET fails closed at startup.
# =============================================================================

# --- 1. Node & Application Runtime Environment ---
NODE_ENV=production                  # Options: development, test, production
PORT=4000                           # Backend API HTTP listening port
WEB_PORT=3000                       # Frontend Web HTTP listening port
WEB_ORIGIN=http://localhost:3000    # Authorized CORS origin for browser requests

# --- 2. Database Configuration (PostgreSQL 18) ---
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/gym_platform_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass
DB_NAME=gym_platform_db
DB_SSL=false

# --- 3. Cache & Distributed Mutex (Redis 8) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- 4. Cryptographic Security & QR Token Signing ---
# MANDATORY IN PRODUCTION: Must be random strings with minimum 32 characters
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_long
JWT_EXPIRATION_HOURS=72
QR_SIGNING_SECRET=your_production_qr_hmac_signing_secret_minimum_32_chars
QR_TTL_SECONDS=45                   # Cryptographic QR token validity duration (seconds)

# --- 5. Frontend Client Configuration (Next.js Public Variables) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# CRITICAL SECURITY: Demo login is DISABLED by default. Never enable in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# --- 6. Iranian SMS OTP Provider (Kavenegar / Ghasedak / Mock) ---
SMS_PROVIDER=mock                   # Options: mock, kavenegar, ghasedak
SMS_API_KEY=your_iranian_sms_provider_api_key
SMS_OTP_PATTERN_CODE=verification_pattern_code
SMS_SENDER_NUMBER=10008000

# --- 7. Iranian Payment Gateway Provider (Shaparak / IPG) ---
PAYMENT_GATEWAY_PROVIDER=mock       # Options: mock, sep, zarinpal
PAYMENT_MERCHANT_ID=your_merchant_id_or_terminal_id
PAYMENT_CALLBACK_URL=http://localhost:3000/payments/callback
PAYMENT_CURRENCY_BASE=TOMAN         # Internal accounting in Tomans, converted to Rials at PSP boundary

# --- 8. Platform Economic Safeguards & Fraud Limits ---
GLOBAL_MAX_PAYOUT_PER_CREDIT_RATIO=32000  # Golden Bounding Inequality limit (Tomans/credit)
DEFAULT_ROLLOVER_PERCENTAGE=0.10          # Maximum monthly unused credit rollover (10%)
DEFAULT_MAX_ROLLOVER_CREDITS=5            # Upper bound on absolute rollover credits
DEFAULT_COOLDOWN_MINUTES=120              # Mandatory rest interval between visits at the same gym
DEFAULT_VENUE_MONTHLY_CAP=4               # Maximum visits per member per individual gym per month
IMPOSSIBLE_VELOCITY_KMH=70                # Velocity fraud threshold across geographic venues
